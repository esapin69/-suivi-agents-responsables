{
  "name": "ghe-suivi-stagiaires-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && npm run typecheck && npm test && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "test": "vitest run --config vitest.config.ts && npm run test:site",
    "test:site": "node --check ../stagiaires.js && node --test ../stagiaires-security.test.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "wrangler types --include-runtime false",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "5.20260812.1",
    "@types/node": "24.2.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
